# Required
BOT_TOKEN=            # from @BotFather
OWNER_ID=             # your Telegram user ID; the bot answers nobody else
DB_URL=               # mysql://user:pass@host:3306/db
WALLET_ADDRESS=       # the wallet the bot watches and trades from

# Only needed to trade. Leave it empty and the bot stays watch-only.
# Use a separate wallet holding only what you can afford to lose.
PRIVATE_KEY=

# Optional
ALERTS_CHAT_ID=       # group or channel for alerts; defaults to your private chat
ALCHEMY_API_KEY=      # faster, more reliable RPC; public nodes are used otherwise
ANKR_API_KEY=
TIMEZONE=Europe/London
SENTRY_DSN=           # error reports, when run on its own
TEST_MODE=
DB_DASHBOARD_URL=             # optional: a web page for your database, shown on database alerts
