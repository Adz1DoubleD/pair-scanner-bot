# Required
SCANNER_BOT_TOKEN=            # from @BotFather
SCANNER_OWNER_ID=             # your Telegram user ID; the bot answers nobody else
SCANNER_DB_URL=               # mysql://user:pass@host:3306/db
SCANNER_WALLET_ADDRESS=       # the wallet the bot watches and trades from

# Only needed to trade. Leave it empty and the bot stays watch-only.
# Use a separate wallet holding only what you can afford to lose.
SCANNER_PRIVATE_KEY=

# Optional
SCANNER_ALERTS_CHAT_ID=       # group or channel for alerts; defaults to your private chat
SCANNER_ALCHEMY_API_KEY=      # faster, more reliable RPC; public nodes are used otherwise
SCANNER_ANKR_API_KEY=
SCANNER_TIMEZONE=Europe/London
SCANNER_SENTRY_DSN=           # error reports, when run on its own
SCANNER_TEST_MODE=
